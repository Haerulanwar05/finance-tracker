# ==========================================
# DATABASE (PostgreSQL / SQLite)
# ==========================================
# Contoh URL lokal: postgresql://postgres:password@localhost:5432/finance_tracker?schema=public
# Contoh Neon/Supabase: postgresql://postgres.[REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_db?schema=public"

# ==========================================
# AUTHENTICATION (NextAuth.js v5)
# ==========================================
AUTH_SECRET="super-secret-key-change-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ==========================================
# GOOGLE OAUTH CREDENTIALS
# ==========================================
AUTH_GOOGLE_ID="your_google_client_id_here"
AUTH_GOOGLE_SECRET="your_google_client_secret_here"

# ==========================================
# AI / OCR (Google Gemini Flash Vision)
# ==========================================
# Dapatkan gratis di https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"
